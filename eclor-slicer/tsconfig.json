{
  "compilerOptions": {
    "allowJs": false,
    "outDir": "./.tmp/build/",
    "sourceMap": true,
    "moduleResolution": "node",
    "declaration": true,
    "target": "ES2020",
    "module": "ES2020",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "removeComments": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "files": ["./src/visual.ts"]
}
