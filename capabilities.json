              },
              {
                "value": "90",
                "displayName": "90°"
              }
            ]
          }
        }
      }
    },
    "subTotals": {
      "displayName": "Subtotals",
      "displayNameKey": "Visual_SubTotals",
      "properties": {
        "rowSubtotals": {
          "displayName": "Row subtotals",
          "type": {
            "bool": true
          }
        },
        "perRowLevel": {
          "displayName": "Per row level",
          "type": {
            "bool": true
