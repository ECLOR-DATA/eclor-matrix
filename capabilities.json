{
  "dataRoles": [
    {
      "displayName": "Rows",
      "name": "rows",
      "kind": "Grouping",
      "description": "One or more dimension columns forming the row hierarchy. Order defines the drill levels (top → bottom)."
    },
    {
      "displayName": "Columns",
      "name": "columns",
      "kind": "Grouping",
      "description": "Optional. One or more dimension columns forming the column hierarchy (cross-tab)."
    },
    {
      "displayName": "Values",
      "name": "values",
      "kind": "Measure",
      "description": "One or more measures shown at each row × column intersection. Field parameters are supported."
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Optional. Additional measures displayed in the hover tooltip of each cell."
    }
  ],
  "dataViewMappings": [
    {
      "matrix": {
        "rows": {
          "for": {
            "in": "rows"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 10000
            }
          }
        },
        "columns": {
          "for": {
            "in": "columns"
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "general": {
      "displayName": "General",
      "displayNameKey": "Visual_General",
      "properties": {
        "textSize": {
          "displayName": "Text size",
          "type": {
            "formatting": {
              "fontSize": true
            }
          }
        },
        "density": {
          "displayName": "Row density",
          "type": {
            "enumeration": [
              {
                "value": "compact",
                "displayName": "Compact"
              },
              {
                "value": "normal",
                "displayName": "Normal"
              },
              {
                "value": "comfortable",
                "displayName": "Comfortable"
              }
            ]
          }
        },
        "rowPadding": {
          "displayName": "Row padding (px, 0 = density)",
          "type": {
            "numeric": true
          }
        }
      }
    },
    "rowHeaders": {
      "displayName": "Row headers",
      "displayNameKey": "Visual_RowHeaders",
      "properties": {
        "bold": {
          "displayName": "Bold",
          "type": {
            "bool": true
          }
        },
        "italic": {
          "displayName": "Italic",
          "type": {
            "bool": true
          }
        },
        "fontColor": {
          "displayName": "Font color",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "indent": {
          "displayName": "Indent per level (px)",
          "type": {
            "numeric": true
          }
        }
      }
    },
    "columnHeaders": {
      "displayName": "Column headers",
      "displayNameKey": "Visual_ColumnHeaders",
      "properties": {
        "bold": {
          "displayName": "Bold",
          "type": {
            "bool": true
          }
        },
        "italic": {
          "displayName": "Italic",
          "type": {
            "bool": true
          }
        },
        "fontColor": {
          "displayName": "Font color",
