{
  "dataRoles": [
    {
      "displayName": "Field",
      "displayNameKey": "Visual_Field",
      "name": "field",
      "kind": "Grouping",
      "description": "One or more columns to filter by. Bind 2+ columns to get a hierarchy tree (order defines the levels, top → bottom).",
      "descriptionKey": "Visual_Field_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Visual_Values",
      "name": "values",
      "kind": "Measure",
      "description": "Optional. A measure displayed next to each item (e.g. sales amount or row count).",
      "descriptionKey": "Visual_Values_Desc"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "field": {
            "max": 6
          },
          "values": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "field"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 10000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "values"
              }
            }
          ]
        }
      }
    }
  ],
