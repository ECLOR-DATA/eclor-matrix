{
  "dataRoles": [
    {
      "displayName": "Rows",
      "name": "rows",
      "kind": "Grouping",
      "description": "One or more dimension columns forming the row hierarchy. Order defines the drill levels (top → bottom)."
    },
    {
      "displayName": "Columns",
      "name": "columns",
      "kind": "Grouping",
      "description": "Optional. One or more dimension columns forming the column hierarchy (cross-tab)."
    },
    {
      "displayName": "Values",
      "name": "values",
      "kind": "Measure",
      "description": "One or more measures shown at each row × column intersection. Field parameters are supported."
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Optional. Additional measures displayed in the hover tooltip of each cell."
    },
    {
      "displayName": "Comments",
      "name": "comments",
      "kind": "Measure",
      "description": "Optional. Text measures carrying data comments (e.g. from a SharePoint list or Excel table related in the model). Shown as row markers, an inline column or the comments panel — never as grid values."
    }
  ],
  "dataViewMappings": [
    {
      "matrix": {
        "rows": {
          "for": {
            "in": "rows"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 10000
            }
          }
        },
        "columns": {
          "for": {
            "in": "columns"
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            },
            {
              "for": {
                "in": "comments"
              }
            }
          ]
        }
      }
    }
  ],
